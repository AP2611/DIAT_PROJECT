# Safe template — tracked in git.
# Copy to .env and fill in real credentials there. .env is gitignored.

VULNTRIAGE_OLLAMA_URL=http://localhost:11434
VULNTRIAGE_OLLAMA_MODEL=mistral
VULNTRIAGE_RAW_DATA_DIR=data/raw
VULNTRIAGE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VULNTRIAGE_SEMGREP_CONFIG=configs/semgrep.yml
VULNTRIAGE_TOP_K=5
VULNTRIAGE_DECISION_THRESHOLD=0.5

# Hosted provider (Gemini API — leave the key blank in this tracked file)
VULNTRIAGE_PROVIDER=gemini
VULNTRIAGE_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
