# Copy to .env and adjust. All values are also settable in configs/default.yaml.

VULNTRIAGE_OLLAMA_URL=http://localhost:11434
VULNTRIAGE_OLLAMA_MODEL=mistral
VULNTRIAGE_RAW_DATA_DIR=data/raw
VULNTRIAGE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VULNTRIAGE_SEMGREP_CONFIG=configs/semgrep.yml
VULNTRIAGE_TOP_K=5
VULNTRIAGE_DECISION_THRESHOLD=0.5
